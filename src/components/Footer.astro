---
// src/components/Footer.astro
import NewsletterForm from './NewsletterForm.astro';

const social = [
  { label: 'RSS', href: '/feed.xml' },
  { label: 'YouTube', href: 'https://www.youtube.com/@mattgilb' },
  { label: 'GitHub', href: 'https://github.com/matt-gilb' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/mgilbert/' },
  { label: 'Mastodon', href: 'https://mastodon.social/@mattgilbert' },
  { label: 'Bluesky', href: 'https://bsky.app/profile/mattg01.bsky.social' },
  { label: 'Reddit', href: 'https://www.reddit.com/user/matt_gilbert/' },
];

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container container--wide footer-inner">

    <!-- Newsletter -->
    <NewsletterForm />

    <!-- Social links -->
    <nav aria-label="Social links" class="social-links">
      {social.map(({ label, href }) => (
        <a href={href} aria-label={label} rel={href.startsWith('http') ? 'noopener noreferrer' : undefined} target={href.startsWith('http') ? '_blank' : undefined}>
          {label}
        </a>
      ))}
    </nav>

    <p class="copyright">© {year} Matt Gilbert</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    padding-block: 2.5rem;
    margin-top: 4rem;
  }
  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: center;
    text-align: center;
  }
  .social-links {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .social-links a {
    font-size: 0.875rem;
    color: var(--color-text);
    text-decoration: none;
  }
  .social-links a:hover { color: var(--color-accent); }
  .copyright {
    font-size: 0.8rem;
    color: var(--color-text);
    opacity: 0.6;
    margin-bottom: 0;
  }
</style>
